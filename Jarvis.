<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, viewport-fit=cover" />
<title>JARVIS — Mohsin AI Core</title>
<meta name="description" content="JARVIS — a personal AI voice assistant built and configured by Mohsin Khan, powered by Gemini." />
<meta name="theme-color" content="#020617" />
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ccircle cx='50' cy='50' r='46' fill='%23020617'/%3E%3Ccircle cx='50' cy='50' r='34' fill='none' stroke='%2338bdf8' stroke-width='3'/%3E%3Ccircle cx='50' cy='50' r='13' fill='%2338bdf8'/%3E%3C/svg%3E" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@500;600;700&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="style.css" />
</head>
<body data-status="idle">

<div id="app">
  <header class="hud-header">
    <div class="corner corner-tl"></div>
    <div class="corner corner-tr"></div>
    <div id="headerCoreSlot" class="header-core-slot">
        <div class="core-orb"></div>
    </div>
    <div class="header-text">
      <div class="app-title">JARVIS</div>
      <div class="app-subtitle">MOHSIN AI CORE</div>
    </div>
    <div class="header-telemetry">
      <div class="status-pill" id="statusPill">
        <span class="status-dot"></span>
        <span id="statusLabel">IDLE</span>
      </div>
      <div class="telemetry-row">
        <span class="telemetry-chip" id="modelBadge" title="Active model">gemini-3.6-flash</span>
        <span class="telemetry-chip mono" id="latencyBadge" title="Last response latency">— ms</span>
      </div>
    </div>
    <button id="settingsBtn" class="icon-btn settings-btn" aria-label="Open settings" title="Settings">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8">
        <circle cx="12" cy="12" r="3.2"></circle>
        <path d="M19.4 13a1.6 1.6 0 0 0 .32 1.77l.05.05a2 2 0 1 1-2.83 2.83l-.05-.05a1.6 1.6 0 0 0-1.77-.32 1.6 1.6 0 0 0-1 1.46V19a2 2 0 1 1-4 0v-.09A1.6 1.6 0 0 0 9 17.4a1.6 1.6 0 0 0-1.77.32l-.05.05a2 2 0 1 1-2.83-2.83l.05-.05A1.6 1.6 0 0 0 4.72 13 1.6 1.6 0 0 0 3.26 12H3a2 2 0 1 1 0-4h.09A1.6 1.6 0 0 0 4.6 7a1.6 1.6 0 0 0-.32-1.77l-.05-.05a2 2 0 1 1 2.83-2.83l.05.05A1.6 1.6 0 0 0 9 2.6a1.6 1.6 0 0 0 1-1.46V1a2 2 0 1 1 4 0v.09A1.6 1.6 0 0 0 15 2.6a1.6 1.6 0 0 0 1.77-.32l.05-.05a2 2 0 1 1 2.83 2.83l-.05.05A1.6 1.6 0 0 0 19.28 7a1.6 1.6 0 0 0 1.46 1H21a2 2 0 1 1 0 4h-.09a1.6 1.6 0 0 0-1.51 1z"></path>
      </svg>
    </button>
  </header>

  <main id="chat" class="chat" aria-live="polite" aria-label="Conversation with JARVIS"></main>

  <div id="statusBar" class="status-bar hidden">
    <span id="statusBarText"></span>
    <button id="stopSpeakBtn" class="stop-chip hidden">■ Stop</button>
  </div>

  <footer class="input-bar">
    <button id="micBtn" class="mic-btn" aria-label="Speak to JARVIS" title="Tap to speak">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8">
        <rect x="9" y="2" width="6" height="12" rx="3"></rect>
        <path d="M5 11a7 7 0 0 0 14 0"></path>
        <line x1="12" y1="18" x2="12" y2="22"></line>
        <line x1="8" y1="22" x2="16" y2="22"></line>
      </svg>
      <span class="mic-pulse"></span>
    </button>
    <textarea id="textInput" class="text-input" rows="1" placeholder="Message JARVIS…" aria-label="Message JARVIS"></textarea>
    <button id="sendBtn" class="send-btn" aria-label="Send message" title="Send">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
        <path d="M3.4 20.6 22 12 3.4 3.4 3 10l13 2-13 2z"></path>
      </svg>
    </button>
  </footer>
</div>

<div id="settingsOverlay" class="overlay hidden">
  <div class="settings-panel" role="dialog" aria-modal="true" aria-labelledby="settingsTitle">
    <div class="settings-header">
      <span id="settingsTitle">SYSTEM CONFIG</span>
      <button id="closeSettingsBtn" class="icon-btn" aria-label="Close settings">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="5" x2="19" y2="19"></line><line x1="19" y1="5" x2="5" y2="19"></line></svg>
      </button>
    </div>
    <div class="settings-body">
      <div class="field-group">
        <label for="apiKeyInput">Gemini API key</label>
        <div class="input-with-btn">
          <input id="apiKeyInput" type="password" autocomplete="off" spellcheck="false" placeholder="Paste your Gemini API key here" />
          <button id="toggleKeyVisBtn" class="mini-btn" type="button" title="Show/hide key">👁</button>
        </div>
      </div>
      <div class="field-group">
        <label for="proxyUrlInput">Secure proxy URL <span class="optional">(optional)</span></label>
        <input id="proxyUrlInput" type="url" autocomplete="off" spellcheck="false" placeholder="https://your-worker.example.workers.dev" />
      </div>
      <div class="field-group">
        <label for="modelInput">Model</label>
        <input id="modelInput" list="modelList" type="text" autocomplete="off" spellcheck="false" value="gemini-1.5-flash" />
        <datalist id="modelList">
          <option value="gemini-1.5-flash">gemini-1.5-flash — Fast & Reliable</option>
          <option value="gemini-1.5-pro">gemini-1.5-pro — Advanced Reasoning</option>
        </datalist>
      </div>
      <div class="field-group row">
        <label for="voiceToggle">Speak responses aloud</label>
        <label class="switch">
          <input type="checkbox" id="voiceToggle" checked />
          <span class="slider"></span>
        </label>
      </div>
      <div class="field-group">
        <label for="recogLangSelect">Voice input language</label>
        <select id="recogLangSelect">
          <option value="en-IN">English (India) — best for Hinglish</option>
          <option value="hi-IN">Hindi (हिन्दी)</option>
        </select>
      </div>
      <div class="field-group">
        <label for="voiceSelect">Speaking voice</label>
        <select id="voiceSelect"></select>
      </div>
      <div class="field-group">
        <button id="clearChatBtn" class="danger-btn" type="button">Clear conversation history</button>
      </div>
    </div>
    <div class="settings-footer">
      <button id="saveSettingsBtn" class="primary-btn" type="button">Save &amp; Close</button>
    </div>
  </div>
</div>
<script src="app.js"></script>
</body>
</html>
